{
  "name": "tenup-theme",
  "version": "1.1.5-next.7",
  "private": true,
  "scripts": {
    "start": "10up-toolkit start --hot",
    "watch": "10up-toolkit start",
    "build": "10up-toolkit build",
    "build:vite": "node ./build.mjs",
    "build:vite:scripts": "node ./build.mjs --mode=production",
    "build:vite:modules": "node ./build.mjs --mode=modules",
    "build:vp": "vp build && vp build --mode modules",
    "build:vp:scripts": "vp build",
    "build:vp:modules": "vp build --mode modules",
    "dev:vite": "vite",
    "dev:vp": "vp dev",
    "playground": "npm run build && npx --yes @wp-playground/cli@latest server --mount=.:/wordpress/wp-content/themes/tenup-theme --blueprint=./blueprint.json --login",
    "playground:vite": "rm -rf dist && vite build --outDir dist && vite build --mode modules --outDir dist && npx --yes @wp-playground/cli@latest server --mount=.:/wordpress/wp-content/themes/tenup-theme --blueprint=./blueprint.json --login",
    "format-js": "10up-toolkit format-js",
    "lint": "npm run lint-js && npm run lint-style",
    "lint-js": "10up-toolkit lint-js",
    "lint-style": "10up-toolkit lint-style",
    "clean-dist": "rm -rf ./dist",
    "wp-env": "wp-env"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^3.0.0",
    "@linaria/babel-preset": "^5.0.3",
    "@linaria/webpack-loader": "^5.0.3",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "@wordpress/env": "^10.10.0",
    "cssnano": "^7.0.0",
    "es-module-lexer": "^1.5.4",
    "fast-glob": "^3.3.2",
    "magic-string": "^0.30.14",
    "postcss-import": "^16.1.0",
    "postcss-mixins": "^11.0.0",
    "postcss-preset-env": "^10.1.0",
    "vite": "^6.0.1",
    "10up-toolkit": "^6.5.1"
  },
  "dependencies": {
    "@10up/block-components": "^1.18.0",
    "@10up/component-accordion": "^2.1.5",
    "@linaria/core": "^5.0.2",
    "@linaria/react": "^5.0.3",
    "@vanilla-extract/css": "^1.15.5",
    "normalize.css": "^8.0.1",
    "prop-types": "^15.7.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "10up-toolkit": {
    "useBlockAssets": true,
    "useScriptModules": false,
    "loadBlockSpecificStyles": true,
    "entry": {
      "admin": "./assets/js/admin/admin.js",
      "frontend": "./assets/js/frontend/frontend.js",
      "shared": "./assets/js/shared/shared.js",
      "styleguide": "./assets/js/styleguide/styleguide.js",
      "admin-style": "./assets/css/admin/admin-style.css",
      "editor-style": "./assets/css/frontend/editor-style.css",
      "shared-style": "./assets/css/shared/shared-style.css",
      "styleguide-style": "./assets/css/styleguide/styleguide.css",
      "core-block-overrides": "./includes/core-block-overrides.js",
      "test-style": "./assets/css/frontend/testing.scss"
    }
  }
}
